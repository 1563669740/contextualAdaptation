# Line-ending policy: LF everywhere in the repository, never checked out as CRLF.
# Reason: dataset/gold/patches/*.patch and dataset/holdout_tests/*/*.diff are patch
# text -- rewriting their line endings breaks the patches; and code/ carries
# byte-level hash checks (code/verify.py), which fail if the working tree is
# converted to CRLF.
* text=auto eol=lf

# Explicitly text
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Patches and diffs must stay byte-exact
*.patch text eol=lf
*.diff  text eol=lf

# Binary: no conversion at all
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.zip     binary
*.gz      binary
*.parquet binary
